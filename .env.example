# ===== App Review Insights 环境变量示例 =====
# 复制为 .env 并按需修改。真实密钥禁止提交到仓库。

# ---- LLM 默认配置（UI 输入优先；此处仅作无 UI / CI 场景兜底）----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ---- 采集限流（合规）----
# COLLECT_INTERVAL=1.5
# COLLECT_MAX_PAGES=10
# COLLECT_TIMEOUT=30

# ---- LLM 调用参数 ----
# LLM_TEMPERATURE_ANALYSIS=0.2
# LLM_TEMPERATURE_WRITING=0.4
# LLM_MAX_RETRIES=2
# LLM_BATCH_SIZE=200

# ---- 证据与去重阈值 ----
# MIN_SUPPORTING_COUNT=3
# DEDUP_THRESHOLD=0.85
